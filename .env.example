# 复制为 .env 后按需修改：docker compose 会自动读取同目录的 .env
# 密码可直接使用 @ : / ? # 等特殊字符（compose 把连接参数分开传给服务端，不拼连接串）；
# 但 Compose 会对 .env 的值做变量插值，密码里的 $ 需写成 $$
POSTGRES_DB=oa
POSTGRES_USER=oa
POSTGRES_PASSWORD=oa
# Postgres 容器监听端口；服务端连接串与健康检查都跟随此值
POSTGRES_PORT=5432

# 端口：OA_HOST_PORT 是宿主机暴露端口，OA_PORT 是容器内监听端口
# 两者可以不同（如宿主机 18787 映射到容器 8787）；浏览器访问的是 OA_HOST_PORT
OA_HOST_PORT=18787
OA_PORT=8787

# 仅供 /api/health 标识实例，便于确认请求落到哪个副本
OA_INSTANCE=docker
RUST_LOG=info

# 跨域白名单（逗号分隔）；不设置则放开所有来源。
# 反向代理 + 同源部署时建议按实际域名收敛，例如：
# OA_CORS_ORIGINS=https://oa.example.com

