# 构建上下文只需要 workspace 清单 + 两个 crate；其余全部排除，镜像层更小也更快
target/
# 前端源码要进上下文（容器内 npm ci + build），但排除本机依赖与产物
frontend/node_modules/
frontend/dist/
frontend/*.log
tools/
deploy/

# 运行期数据与凭据，绝不能进镜像
.env
.env.*
*.db
oa-files/

# 版本控制与本机状态
.git/
.gitignore
.gitattributes
.github/
.workbuddy/
.playwright-cli/
.cargo/

# 文档与诊断日志
*.log
*.md
after-login.yaml
