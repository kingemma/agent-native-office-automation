# Rust / Cargo 构建产物
/target/

# 本机 MinGW-w64 GCC 工具链（由 tools/check.sh 使用，约 465MB，不入库）
# 新机器按 tools/check.sh 顶部说明重新解压 MSYS2 包即可
/tools/mingw-bin/
/tools/pkgs/
/tools/*.exe
/tools/*.o

# 前端
node_modules/
/frontend/dist/
/frontend/.vite/

# 临时诊断日志
*.log

# 本地运行数据：SQLite 库（含 -wal/-shm）与附件落盘目录，首次启动自动创建
/oa.db
/oa.db-shm
/oa.db-wal
/oa-files/

# 本机工具产生的调试状态
/.playwright-cli/
/.workbuddy/

# release 流水线运行时生成的合并配置（含证书指纹，不入库）
/src-tauri/tauri.ci.conf.json

# 系统文件
.DS_Store
Thumbs.db
.env